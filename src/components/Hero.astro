<section class="hero" id="inicio">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="badge">
        <span class="badge__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M13 2 4.5 13H11l-1 9L19.5 11H13V2Z" fill="currentColor"></path>
          </svg>
        </span>
        <span class="badge__label">Versión 2.0 en Vivo</span>
        <span class="badge__dot" aria-hidden="true"></span>
      </p>

      <h1 class="hero__title">
        100 respuestas.<br />
        <span class="text-gradient">Una IA.</span><br />
        Cero filtros.
      </h1>

      <p class="hero__lead">
        Convierte cualquier tema en un guion de{" "}
        <strong>100 Artificiales Dijeron</strong> con preguntas, respuestas y puntos
        listos para jugar.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#precios">
          <span class="btn__label">Comenzar Ahora</span>
          <svg class="btn__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>

        <a class="btn btn--ghost" href="#caracteristicas">
          <svg class="btn__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 5.5v13l10-6.5-10-6.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
          </svg>
          <span class="btn__label">Ver cómo funciona</span>
        </a>
      </div>

      <p class="hero__note">Sin tarjeta · 3 guiones gratis · Listo en segundos</p>
    </div>

    <div class="hero__board">
      <div class="board" role="img" aria-label="Tablero de ejemplo con cinco respuestas y sus puntos">
        <div class="board__header">
          <span class="board__kicker">Tablero en vivo</span>
          <span class="board__status">IA conectada</span>
        </div>

        <div class="board__row board__row--hot" style="--i: 0">
          <span class="board__num">1</span>
          <span class="board__answer">El primo que “sabe de todo”</span>
          <span class="board__points">38</span>
        </div>
        <div class="board__row" style="--i: 1">
          <span class="board__num">2</span>
          <span class="board__answer">“¿Ya comieron?”</span>
          <span class="board__points">24</span>
        </div>
        <div class="board__row" style="--i: 2">
          <span class="board__num">3</span>
          <span class="board__answer">La tía que pregunta por el novio</span>
          <span class="board__points">17</span>
        </div>
        <div class="board__row" style="--i: 3">
          <span class="board__num">4</span>
          <span class="board__answer">El tío que saca la política</span>
          <span class="board__points">12</span>
        </div>
        <div class="board__row" style="--i: 4">
          <span class="board__num">5</span>
          <span class="board__answer">“No traje efectivo”</span>
          <span class="board__points">9</span>
        </div>
      </div>

      <div class="board-prompt" aria-hidden="true">
        <span class="board-prompt__label">Tema</span>
        <span class="board-prompt__text">Reunión familiar que termina en discusión</span>
        <span class="board-prompt__cursor"></span>
      </div>
    </div>
  </div>
</section>
